<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pizzaempire.game"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:testOnly="true"
        android:theme="@style/AppTheme" >

        <!-- The app now starts at the login screen -->
        <activity
            android:name="com.pizzaempire.game.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.pizzaempire.game.SignUpActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.pizzaempire.game.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.pizzaempire.game.LeaderboardActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.pizzaempire.game.WorldActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.pizzaempire.game.ShopActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.pizzaempire.game.SettingsActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>